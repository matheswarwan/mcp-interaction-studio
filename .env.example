# Interaction Studio instance (no trailing slash)
# Example: https://demo.us-1.evergage.com
# Find this in your browser URL after logging into Gears (/ui/)
IS_BASE_URL=https://demo.us-1.evergage.com

# JSESSIONID from browser DevTools → Network → any evergage.com request → Cookie header
# Copy only the value after JSESSIONID= (not the whole Cookie string)
IS_SESSION_ID=

# Optional: default dataset when tools don't receive a dataset parameter
# IS_DEFAULT_DATASET=my-dataset

# Set to true when behind Zscaler/corporate SSL inspection (equivalent to curl -k)
IS_TLS_INSECURE=true

# Set to true to enable write tools (set_campaign_state, set_segment_enabled)
# IS_WRITES_ENABLED=true

# Optional: path to Zscaler/corporate root CA instead of IS_TLS_INSECURE
# NODE_EXTRA_CA_CERTS=/path/to/corporate-root.pem
